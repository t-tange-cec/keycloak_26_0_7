<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet author="keycloak" id="26.0.7-34013">
        <createTable tableName="CHECK_ITEM">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CHECK_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="LOCALE" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="REALM_RISKBASE">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CHECK_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="SCORE" type="VARCHAR(5)">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLED" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="QUESTION_MASTER">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="QID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="LOCALE" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="CONTENT" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
